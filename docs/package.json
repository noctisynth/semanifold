{
  "name": "@semifold/docs",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "check": "bun run typecheck && bun run test:install && bun run ./scripts/check-locales.mjs && bun run build && bun run ./scripts/check-static-output.mjs",
    "dev": "next dev",
    "generate": "bun run ./scripts/generate-source.mjs",
    "preview": "serve out --listen 4173",
    "test:install": "node --test scripts/install.test.mjs",
    "typecheck": "bun run generate && tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fumadocs-core": "^16.14.3",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-ui": "^16.14.3",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
