{
  "name": "@semifold/plugin-sdk",
  "version": "0.1.0",
  "description": "TypeScript protocol types and helpers for Semifold ecosystem plugins",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "bun run check:protocol && bun run check:biome",
    "check:biome": "biome check src test package.json tsconfig.json",
    "check:protocol": "cargo run -p semifold-resolver --example generate_plugin_sdk --features ts-rs -- --check",
    "format": "biome format --write src test package.json tsconfig.json",
    "generate:protocol": "cargo run -p semifold-resolver --example generate_plugin_sdk --features ts-rs",
    "prepack": "tsc -p tsconfig.json",
    "test": "bun run build && bun run test:types && bun run test:runtime",
    "test:runtime": "bun test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json"
  },
  "author": {
    "name": "苏向夜",
    "email": "fu050409@163.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noctisynth/semifold.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/noctisynth/semifold/issues"
  },
  "homepage": "https://github.com/noctisynth/semifold#readme",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "typescript": "^7.0.2"
  }
}
