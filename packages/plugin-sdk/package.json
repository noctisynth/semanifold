{
  "name": "@semifold/plugin-sdk",
  "version": "0.0.0",
  "description": "TypeScript protocol types and helpers for Semifold ecosystem plugins",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "pnpm run build && pnpm run test:types && pnpm run test:runtime",
    "test:runtime": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json"
  },
  "author": {
    "name": "苏向夜",
    "email": "fu050409@163.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noctisynth/semifold.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/noctisynth/semifold/issues"
  },
  "homepage": "https://github.com/noctisynth/semifold#readme",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
